# Supabase credentials
VITE_SUPABASE_URL=https://zssasbllfjeaailfteep.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_RmkUSCdjd71U6_gYlkb7Nw_Of8u4QLx

# Random secret you choose yourself — protects the cron endpoint from being
# triggered by anyone who finds the URL. Set the SAME value here and in
# Vercel; Vercel automatically sends it as "Authorization: Bearer <value>"
# when it calls the scheduled function.
CRON_SECRET=

# Njoftimet Push (Web Push) — VAPID keys. Publiku (VITE_VAPID_PUBLIC_KEY) shkon
# në frontend (bundle-i publik, jo sekret); privati (VAPID_PRIVATE_KEY) vetëm
# server-side te Vercel, ASNJËHERË në frontend. Të dyja duhen te Vercel
# (Project Settings → Environment Variables) — VITE_VAPID_PUBLIC_KEY duhet
# edhe lokalisht te .env që `npm run build` ta përfshijë në bundle.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com
